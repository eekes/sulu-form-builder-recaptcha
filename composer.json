{
    "name": "eekes/sulu-form-builder-recaptcha",
    "type": "symfony-bundle",
    "description": "Invisible reCAPTCHA v3 spam check for eekes/sulu-form-builder-bundle: switch it on per form, blocked submissions land in the Spam tab",
    "keywords": ["sulu", "sulu-bundle", "forms", "form-builder", "recaptcha", "spam"],
    "license": "MIT",
    "authors": [
        {
            "name": "Ewald Vanderveken",
            "email": "vandervekenewald@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "eekes/sulu-form-builder-bundle": "^0.1@dev",
        "psr/log": "^3.0",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/form": "^7.4",
        "symfony/http-client": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/translation-contracts": "^3.5"
    },
    "require-dev": {
        "php-cs-fixer/shim": "^3.58",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/translation": "^7.4",
        "symfony/twig-bridge": "^7.4",
        "twig/twig": "^3.14"
    },
    "autoload": {
        "psr-4": {
            "Eekes\\Sulu\\FormBuilderRecaptchaBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eekes\\Sulu\\FormBuilderRecaptchaBundle\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../bundle"
        }
    ],
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
